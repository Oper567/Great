# Great-Favour Montessori School (GFMS) Environment Variables

# PostgreSQL Database URL for Prisma & Direct Connections
DATABASE_URL="postgresql://postgres:password@localhost:5432/gfms_db?schema=public"

# For Local SQLite testing (optional):
# DATABASE_URL="file:./dev.db"

# Next.js Application
NEXT_PUBLIC_APP_NAME="Great-Favour Montessori School"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Dedicated CBT Subdomain & PWA Configuration
# In production on cPanel: NEXT_PUBLIC_CBT_URL="https://cbt.greatfavourmontessori.com.ng"
# In local development: NEXT_PUBLIC_CBT_URL="http://cbt.localhost:3000"
NEXT_PUBLIC_CBT_URL="http://cbt.localhost:3000"
CBT_SUBDOMAIN_PREFIX="
"

# Session Cookie Domain Scope (Optional)
# Leave empty for host-only cookies, or set to ".greatfavourmontessori.com.ng" for shared root domain cookies
# COOKIE_DOMAIN=".greatfavourmontessori.com.ng"

# Authentication & Cryptographic Secrets (generate random 32+ byte hex strings in production)
SESSION_SECRET="<generate-strong-32-byte-random-hex-secret>"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="<generate-strong-32-byte-random-hex-secret>"
# ENABLE_SETUP_DB="false"
# SETUP_SECRET="<generate-strong-random-setup-secret-at-least-16-chars>"
# INITIAL_ADMIN_PASSWORD="<set-only-for-initial-bootstrap-then-remove>"

# Database Engine Mode
FORCE_PURE_PG="true"

# Tawk.to Live Chat Widget (Optional override)
# NEXT_PUBLIC_TAWK_PROPERTY_ID="6af85917f1c0003c425d8234"
# NEXT_PUBLIC_TAWK_WIDGET_ID="1k7d1o35j"

